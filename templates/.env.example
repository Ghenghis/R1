# Copy to proxy/.env and fill in YOUR OWN keys. Do not commit the filled file.
# Only your own MiniMax / DeepSeek / SiliconFlow keys belong here.

PORT=8787
ALLOWED_ORIGIN=*
APP_TOKEN=
ENABLE_FALLBACK=false

# Your own provider keys (leave blank to disable a provider)
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# Base URLs (defaults shown)
MINIMAX_BASE_URL=https://api.minimax.io/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional model overrides
# MINIMAX_MODEL=MiniMax-Text-01
# DEEPSEEK_MODEL=deepseek-chat
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Routing
DEFAULT_PROVIDER=minimax
FALLBACK_PROVIDER=deepseek
SECOND_FALLBACK_PROVIDER=siliconflow
